<?xml version="1.0" encoding="UTF-8"?>
<!-- Сменное задание: свободные (сколько часов не распределено) и недоступные (причина, срок) -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="e" pageWidth="802" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<style name="DefaultStyle" isDefault="true" vTextAlign="Middle" fontName="DejaVu Sans" pdfFontName="DejaVu Sans" fontSize="10">
		<paragraph leftIndent="3" rightIndent="3"/>
	</style>
	<style name="Cell" vTextAlign="Middle" fontName="DejaVu Sans" pdfFontName="DejaVu Sans" fontSize="10">
		<box>
			<pen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
		</box>
		<paragraph leftIndent="3" rightIndent="3"/>
	</style>
	<field name="e.object" class="java.lang.Long"/>
	<field name="section" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="positionFree" class="java.lang.String"/>
	<field name="detail" class="java.lang.String"/>
	<group name="section" minHeightToStartNewPage="50">
		<groupExpression><![CDATA[$F{section}]]></groupExpression>
		<groupHeader>
			<band height="26" splitType="Prevent">
				<textField isBlankWhenNull="true">
					<reportElement style="Cell" mode="Opaque" backcolor="#E6E6E6" x="0" y="8" width="802" height="18"/>
					<textElement>
						<font isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{section}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<detail>
		<band height="18" splitType="Prevent">
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement style="Cell" stretchType="RelativeToBandHeight" x="0" y="0" width="320" height="18"/>
				<textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement style="Cell" stretchType="RelativeToBandHeight" x="320" y="0" width="130" height="18"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{positionFree}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement style="Cell" stretchType="RelativeToBandHeight" x="450" y="0" width="352" height="18"/>
				<textFieldExpression><![CDATA[$F{detail}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
